[Unit]
Description=NexusPulse - Next-Gen Server Monitoring & Operations OS
After=network.target

[Service]
Type=simple
User=hongju
WorkingDirectory=/mnt/workspace/server-management/nexus-pulse
ExecStart=/usr/bin/node /mnt/workspace/server-management/nexus-pulse/server/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=4500
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
UMask=0077
Environment=HERMES_BIN=/mnt/hermes/engine/hermes-agent/venv/bin/hermes
Environment=HERMES_HOME=/mnt/hermes/engine
Environment=PATH=/mnt/hermes/engine/hermes-agent/venv/bin:/home/hongju/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ReadWritePaths=/mnt/storage /mnt/workspace/server-management/nexus-pulse/data /mnt/hermes/engine /home/hongju/.cache

[Install]
WantedBy=multi-user.target
